# Copy this file to .env (untracked by git, safe to fill in with real values)
# and Docker Compose picks it up automatically -- no need to edit
# docker-compose.yml directly. Every variable below is optional; the
# defaults already baked into docker-compose.yml work out of the box for a
# local/LAN-only setup with automatic expense capture left unconfigured.

# --- Frontend / gateway networking ---
# The address your BROWSER uses to reach the gateway -- your host machine's
# LAN IP if accessing from other devices, or localhost if only ever opening
# this from the same machine it runs on. See README.md "Self-hosting on a
# home server".
# VITE_GATEWAY_URL=http://192.168.1.10:8080
# ALLOWED_ORIGINS=http://192.168.1.10:4173,http://localhost:4173

# Optional shared-secret gate for the gateway -- unset by default, meaning
# no authentication (fine for a local/LAN-only setup). Set this if you're
# exposing the gateway more broadly (port-forwarded, a shared network, a
# reverse-proxied domain): every request except /health then needs a
# matching X-API-Key header. The frontend is built with the same value
# baked in, so it keeps working automatically -- just rebuild it
# (`docker compose up --build`) after setting this.
# API_KEY=

# Largest single fund/ETF factsheet that may be uploaded, in bytes
# (default 26214400 = 25 MB). Read by BOTH geo-allocation, which stores the
# file, and the gateway, which the browser actually posts it through and
# which will not buffer more than this. Raise it in one place and both
# follow; a real factsheet is a few MB at most.
# MAX_UPLOAD_SIZE_BYTES=26214400

# Where core-networth and geo-allocation write the daily copy and the
# pre-restore safety copy. Defaults to /backups, which is what
# docker-compose bind-mounts to ./backups/ on the host -- leave it alone for
# a Docker deployment. It matters if you run the services DIRECTLY on the
# host (see "Local development" in README.md): /backups is at the filesystem
# root and only root can create it, so point this at somewhere your user can
# write. If it is not writable the services fall back to a folder inside
# DATA_DIR and log where the backup actually went, rather than losing it.
# BACKUP_DIR=/backups

# --- bank-sync (optional automatic expense capture, see services/bank-sync/) ---
# Your Enable Banking application id, from their Control Panel.
# ENABLE_BANKING_APP_ID=

# The address YOUR BROWSER can reach bank-sync at, used to build each
# bank's login redirect URL -- must exactly match what you registered with
# Enable Banking. Any of: your host machine's LAN IP, a Tailscale address,
# or a reverse-proxied domain. See services/bank-sync/README.md.
# BANK_SYNC_PUBLIC_BASE_URL=http://192.168.1.10:8003
