# Copy this file to .env (untracked by git, safe to fill in with real values)
# and Docker Compose picks it up automatically -- no need to edit
# docker-compose.yml directly. Every variable below is optional; the
# defaults already baked into docker-compose.yml work out of the box for a
# local/LAN-only setup with automatic expense capture left unconfigured.

# --- Frontend / gateway networking ---
# The address your BROWSER uses to reach the gateway -- your host machine's
# LAN IP if accessing from other devices, or localhost if only ever opening
# this from the same machine it runs on. See README.md "Self-hosting on a
# home server".
# VITE_GATEWAY_URL=http://192.168.1.10:8080
# ALLOWED_ORIGINS=http://192.168.1.10:4173,http://localhost:4173

# --- bank-sync (optional automatic expense capture, see services/bank-sync/) ---
# Your Enable Banking application id, from their Control Panel.
# ENABLE_BANKING_APP_ID=

# The address YOUR BROWSER can reach bank-sync at, used to build each
# bank's login redirect URL -- must exactly match what you registered with
# Enable Banking. Any of: your host machine's LAN IP, a Tailscale address,
# or a reverse-proxied domain. See services/bank-sync/README.md.
# BANK_SYNC_PUBLIC_BASE_URL=http://192.168.1.10:8003
